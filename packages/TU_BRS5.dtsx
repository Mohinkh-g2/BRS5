      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="Fetch_old_datefiled_count">
      <DTS:VariableValue
        DTS:DataType="8">SELECT COUNT(*) FROM dbo.Primary_Case_Daily WHERE DATEDIFF(DAY,DATEFROMPARTS(CONCAT(20, RIGHT(Date_Reported, 2)), LEFT(Date_Reported, 2), SUBSTRING(Date_Reported, 3, 2)),CAST(Created_DT AS DATE)) &gt;= 365*2 AND Update_Flag = 1</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{D049C0A8-CF0C-45EF-A824-062B18137249}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="Fetch_old_paiddate_count">
      <DTS:VariableValue
        DTS:DataType="8">SELECT COUNT(*) FROM dbo.Primary_Case_Daily WHERE DATEDIFF(DAY,DATEFROMPARTS(CONCAT(20, RIGHT(Date_Paid, 2)), LEFT(Date_Paid, 2), SUBSTRING(Date_Paid, 3, 2)),CAST(Created_DT AS DATE)) &gt;= 365*2 AND Date_Paid != '000000' AND Update_Flag = 1</DTS:VariableValue>
    </DTS:Variable>

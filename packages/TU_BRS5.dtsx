                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select
  convert(nvarchar(4),[Record_Descriptor_Word]) [Record_Descriptor_Word]
, convert(nvarchar(7),right(replicate(' ',7)+[Identification_Number],7)) [Identification_Number]
, convert(nvarchar(17),right(replicate(' ',17)+[Docket_Number],17)) [Docket_Number]

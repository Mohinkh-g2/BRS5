, convert(nvarchar(7),[Reserved4]) [Reserved4]
, convert(nvarchar(7),[Reserved5]) [Reserved5]
, convert(nvarchar(9),[Social_Security_Number]) [Social_Security_Number]
, convert(nvarchar(2),[Reserved6]) [Reserved6]
, convert(nvarchar(1),[Reserved7]) [Reserved7]
, convert(nvarchar(6),[ZIP_Code]) [ZIP_Code]
, convert(nvarchar(1),[Association_Code_Output]) [Association_Code]
, convert(nvarchar(2),[Plaintiff_classification_Code]) [Plaintiff_classification_Code]
, convert(nvarchar(32),[Name_Field]) [Name_Field]
, convert(nvarchar(1),[Generation_Code]) [Generation_Code]
, convert(nvarchar(32),[First_Line_of_Address]) [First_Line_of_Address]
, convert(nvarchar(32),[Second_Line_of_Address]) [Second_Line_of_Address]
, convert(nvarchar(22),[Plaintiff]) [Plaintiff]
, convert(nvarchar(18),[Attorney]) [Attorney]
, convert(nvarchar(8),[Date_of_Birth]) [Date_of_Birth]
, convert(nvarchar(8),[Collection_Date]) [Collection_Date]
, convert(nvarchar(5),[Reserved8]) [Reserved8]
FROM [dbo].[Primary_Case_Daily]
where [Update_Flag]&lt;&gt;'0'
order by [Public_Record_Type] desc,[Identification_Number],[Docket_Number],[Name_Type] desc</property>
